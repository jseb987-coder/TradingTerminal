{
  "name": "trading-terminal",
  "version": "1.0.0",
  "description": "Trading Terminal packaged as a native executable using pkg",
  "private": true,
  "bin": "server.js",
  "dependencies": {
    "axios": "^1.12.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "buffer": "^6.0.3",
    "protobufjs": "^7.2.5",
  "express": "^4.18.2"
  },
  "scripts": {
    "start-client": "react-scripts start",
    "build": "react-scripts build",
    "clean": "rimraf build dist",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "pkg": "pkg . --out-path dist",
    "build-exe": "npm run build && npm run pkg"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "react-scripts": "5.0.1",
    "rimraf": "^3.0.2"
  },
  "pkg": {
    "assets": [
      "build/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  }
}
